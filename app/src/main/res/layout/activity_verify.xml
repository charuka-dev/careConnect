<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header Section -->

    <TextView
        android:id="@+id/textView14"
        android:layout_width="296dp"
        android:layout_height="28dp"
        android:layout_marginStart="56dp"
        android:layout_marginTop="760dp"
        android:fontFamily="@font/hind_regular"
        android:text="Need to change your email?Go back "
        android:textColor="#000000"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView12"
        android:layout_width="129dp"
        android:layout_height="31dp"
        android:layout_marginStart="140dp"
        android:layout_marginTop="564dp"
        android:fontFamily="@font/hind_regular"
        android:text="Resend Code"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <EditText
        android:id="@+id/editTextOTP5"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="316dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edit_text_bg"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="1"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView4" />

    <EditText
        android:id="@+id/editTextOTP4"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="240dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edit_text_bg"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="1"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView4" />

    <EditText
        android:id="@+id/editTextOTP3"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="164dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edit_text_bg"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="1"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView4" />

    <EditText
        android:id="@+id/editTextOTP2"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="88dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edit_text_bg"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="1"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView4" />

    <EditText
        android:id="@+id/editTextOTP1"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edit_text_bg"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="1"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView4" />

    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="0dp"
        android:layout_height="257dp"
        android:background="#DCF2F8"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="125dp"
            android:layout_height="103dp"
            android:contentDescription="@string/app_name"
            app:srcCompat="@drawable/whatsapp_image_2025_10_12_at_20_59_49_e8fea1b6" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:text="Verify Email Address"
            android:textColor="#2E8791"
            android:textSize="32sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/textView10"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="34dp"
        android:layout_marginEnd="34dp"
        android:layout_marginTop="303dp"
        android:text="Please verify your email address to continue. Check your inbox for the verification link and follow the instructions to complete your registration."
        android:textColor="#000000"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="235dp"
        android:layout_height="33dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="436dp"
        android:fontFamily="@font/hind_regular"
        android:text="Verification Code"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button10"
        android:layout_width="354dp"
        android:layout_height="41dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/button_background"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/confirm_continue"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:cornerRadius="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView12" />


</androidx.constraintlayout.widget.ConstraintLayout>
